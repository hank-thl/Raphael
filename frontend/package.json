{
  "name": "raphael-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.21.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "preview": "nuxt preview --host 127.0.0.1",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test:auth": "node --experimental-strip-types --test tests/auth-errors.test.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "nuxt": "~4.6.4",
    "vue": "^3.5.0",
    "vue-router": "^4.6.0",
    "firebase": "^12.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vue-tsc": "^3.1.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.13.6"
    },
    "@vercel/nft": {
      "glob": "14.0.6"
    },
    "readdir-glob": {
      "minimatch": "11.0.8"
    }
  }
