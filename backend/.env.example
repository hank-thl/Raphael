# 由 uv run --env-file .env uvicorn ... 載入（不自動讀取 .env）
FIREBASE_PROJECT_ID=
# 指向專案目錄以外的管理員憑證檔案；不要提交該檔或內容。
GOOGLE_APPLICATION_CREDENTIALS=
# Firebase UID，以逗號分隔；留空時不允許任何帳號。
ALLOWED_FIREBASE_UIDS=
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 完成服務端禁註冊及指定 Google 身分設定、驗證後才能設 true。
AUTH_SIGNUP_RESTRICTION_CONFIRMED=false
# 僅本機 HTTP 開發可用 false；公開 HTTPS 必須 true。
COOKIE_SECURE=false
# 預設一天；到期重新登入。登出僅清除此瀏覽器，不撤銷其他裝置。
SESSION_SECONDS=86400
